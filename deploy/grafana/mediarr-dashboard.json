{
  "title": "Mediarr",
  "uid": "mediarr",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "multi": false,
          "query": "prometheus",
          "refresh": 1,
          "regex": ""
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queue depth (all states)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 50 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "sum(mediarr_queue_depth)", "legendFormat": "total", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Library items",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "expr": "sum by (kind) (mediarr_library_items)", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dependencies up",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "expr": "mediarr_dependency_up", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Indexers healthy",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "expr": "mediarr_indexer_healthy", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Build",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none" },
      "targets": [
        { "expr": "mediarr_build_info", "legendFormat": "{{version}} ({{commit}})", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue depth by state",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (state) (mediarr_queue_depth)", "legendFormat": "{{state}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pipeline run rate by outcome",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (result) (rate(mediarr_pipeline_runs_total[15m]))", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pipeline run duration (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(mediarr_pipeline_run_duration_seconds_bucket[15m])))", "legendFormat": "p50 {{kind}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(mediarr_pipeline_run_duration_seconds_bucket[15m])))", "legendFormat": "p95 {{kind}}", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Imports (rate)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (kind) (rate(mediarr_pipeline_imports_total[1h]))", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Indexer call rate by outcome",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (name, result) (rate(mediarr_indexer_calls_total[15m]))", "legendFormat": "{{name}} {{result}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Indexer call latency (p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, name) (rate(mediarr_indexer_call_latency_seconds_bucket[15m])))", "legendFormat": "{{name}}", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP request rate by status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (status) (rate(mediarr_http_requests_total[15m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "HTTP request duration (p95 by route)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(mediarr_http_request_duration_seconds_bucket[15m])))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    }
  ]
}
